{
  "name": "aoi",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm start -w apps/backend",
    "dev:client": "npm run dev -w apps/frontend",
    "start": "npm start -w apps/backend",
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">= 22.0.0"
  },
  "version": "0.1.0",
  "description": "A Colyseus multiplayer server"
}
